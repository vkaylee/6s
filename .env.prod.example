# =============================================================================
# 6S — Staging / Production environment template
# =============================================================================
# Copy to .env.prod (git-ignored) and fill in REAL values. NEVER commit secrets.
#   cp .env.prod.example .env.prod
#   podman compose --env-file .env.prod -f .compose/docker-compose.prod.yml up -d
#
# The compose file FAILS CLOSED if a required secret is missing.
# Generate strong values, e.g.:
#   JWT_SECRET:          openssl rand -base64 48      (>= 32 bytes)
#   APP_ENCRYPTION_KEY:  openssl rand -base64 32      (exactly 32 raw bytes)
#   DB_PASSWORD:         openssl rand -base64 24
# =============================================================================

# === Database roles ===
# Admin is used only by the one-shot role provisioner; never give it to the app.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-me-in-production
DB_NAME=6s_db
MIGRATOR_USER=6s_migrator
MIGRATOR_PASSWORD=change-me-migrator
RUNTIME_USER=6s_runtime
RUNTIME_PASSWORD=change-me-runtime
# Optional migration deadlines.
MIGRATION_LOCK_TIMEOUT=30s
MIGRATION_STATEMENT_TIMEOUT=5m
MIGRATION_TIMEOUT=10m
# === Authentication ===
# Required. HMAC signing secret, minimum 32 bytes.
JWT_SECRET=change-me-in-production-min-32-bytes

# === Encryption ===
# Required for field-level encryption. Base64-encoded 32-byte master key
# (or a raw 32-character string). Used by internal/crypto.
APP_ENCRYPTION_KEY=

# === Network / edge ===
# Comma-separated trusted proxy IPs. Caddy is the only client of the server.
TRUSTED_PROXIES=127.0.0.1
# Host ports exposed by the Caddy edge proxy.
PROD_HTTP_PORT=8081
PROD_HTTPS_PORT=8444

# === Image identity ===
# Image reference used by the server service. Defaults to a local build.
APP_IMAGE=localhost/6s-app
APP_TAG=prod
# Optional: source revision baked into the image label for traceability.
GIT_REVISION=unknown

# === Compose project ===
COMPOSE_PROJECT_NAME=6s-prod
