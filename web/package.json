{
  "name": "6s-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check-file-length": "node scripts/check-file-length.mjs",
    "lint": "node scripts/check-file-length.mjs && biome check . && tsc --noEmit",
    "lint:fix": "node scripts/check-file-length.mjs && biome check --write . && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "check-i18n": "bun test test/i18n.test.tsx",
    "openapi:check": "node scripts/openapi-operations.mjs",
    "openapi:generate": "openapi-ts --file openapi-ts.config.ts --output src/api/generated",
    "openapi:drift": "node scripts/openapi-generate-check.mjs",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:e2e": "bunx playwright test --workers=1"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "wouter": "^3.10.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@happy-dom/global-registrator": "^21.0.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "^1.4.1",
    "js-yaml": "^4.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.6.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "source-map-js": "^1.2.4"
  },
  "resolutions": {
    "js-yaml": "4.3.2",
    "source-map-js": "^1.2.4"
  }
}
