{
  "name": "6s-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write . && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "check-i18n": "bun test test/i18n.test.tsx",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.10.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
