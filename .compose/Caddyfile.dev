{
  servers :443 {
    protocols h1 h2
  }
  on_demand_tls {
    ask http://server:8080/api/health
  }
}

:80 {
  redir https://{host}:8443{uri} 308
}

:443 {
  tls internal {
    on_demand
  }
  encode gzip

  header {
    Strict-Transport-Security "max-age=31536000"
  }

  handle /api/* {
    reverse_proxy server:8080
  }

  handle {
    reverse_proxy web:5173
  }
}
