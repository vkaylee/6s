# Server runtime configuration
#
# Copy to .env (git-ignored) and fill in real values. NEVER commit real secrets.

# === Application ===
SERVER_PORT=8080
DATA_DIR=./data

# === Database ===
# Required. Use sslmode=require or stronger (verify-full in production).
# Local docker-compose dev default uses sslmode=disable; set DEV_INSECURE=1 to allow it.
DB_DSN=postgres://user:change-me-in-production@localhost:5432/6s_db?sslmode=require

# === Authentication ===
# Required. HMAC secret, minimum 32 bytes.
JWT_SECRET=change-me-in-production-min-32-bytes

# === TLS (optional; reverse proxy may terminate TLS instead) ===
# If set, both must be provided together and the server serves HTTPS directly.
TLS_CERT=
TLS_KEY=

# === Encryption ===
# Optional. Base64-encoded 32-byte master key for field encryption.
APP_ENCRYPTION_KEY=

# === Network ===
# Comma-separated trusted proxy IPs.
TRUSTED_PROXIES=127.0.0.1

# === Development escape hatch ===
# Set to 1 ONLY for local development to permit sslmode=disable DSNs and plain HTTP.
DEV_INSECURE=
